# Model gateway configuration.
# Copy to `.env.gateway` (git-ignored) and fill in for LIVE runs only.
# The fake gateway (npm run gateway:dev:fake) needs none of these secrets.
#
# NEVER commit a real key. NEVER create a VITE_-prefixed secret: anything
# with a VITE_ prefix is bundled into browser code.

# OpenRouter live adapter. Use one exact provider/model slug and one exact
# provider endpoint slug. The adapter sends require_parameters=true,
# allow_fallbacks=false, and provider.only=[OPENROUTER_PROVIDER].
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_PROVIDER=

# Optional OpenRouter app attribution. For localhost, pair the URL with a title.
OPENROUTER_HTTP_REFERER=http://localhost:5173
OPENROUTER_APP_TITLE=The Last Meal

MODEL_GATEWAY_PORT=8787
MODEL_REQUEST_TIMEOUT_MS=20000
MODEL_MAX_CONCURRENCY=1
MODEL_MAX_CALLS_PER_RUN=80
# Process-wide upstream spend cap across ALL runs: at/over the cap every call
# fails as a typed budget-exhausted failure before reaching the adapter.
# Idempotent replays never consume the cap.
MODEL_MAX_TOTAL_CALLS=400
MODEL_TRACE_DIR=artifacts/model-runs
# Must match the origin the Vite dev server actually prints (localhost /
# 127.0.0.1 / [::1] are interchangeable, but the port is not pinned — Vite
# increments when 5173 is taken). A mismatch is a 403 origin-forbidden on
# every request and shows in the model panel as 'unavailable'.
ALLOWED_BROWSER_ORIGIN=http://localhost:5173
