{
  "name": "causal-npc-lab",
  "private": true,
  "version": "1.4.0",
  "description": "Vertical Slice 001 - The Last Meal: deterministic causal-NPC simulation testbed (remediation release 1.1.0; re-audit remediation 1.2.0; model integration milestone 001 at 1.3.0; re-audit remediation 1.4.0)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "typecheck:gateway": "tsc -p gateway/tsconfig.json",
    "lint": "eslint . && prettier --check .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:gateway": "vitest run tests/gateway",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "test:model:live": "tsx scripts/model/liveSmoke.ts",
    "validate": "tsx scripts/validate/run.ts",
    "batch": "tsx scripts/batch/run.ts",
    "eval:individuality": "tsx scripts/evaluation/individuality.ts",
    "gateway:dev": "tsx gateway/main.ts",
    "gateway:dev:fake": "tsx gateway/main.ts --fake",
    "build:gateway": "vite build --config gateway/vite.config.ts",
    "check:dist": "tsx scripts/security/scanDist.ts",
    "model:summarize": "tsx scripts/model/summarize.ts",
    "model:prepare-run": "tsx scripts/model/prepareRun.ts",
    "model:finalize": "tsx scripts/model/finalize.ts"
  },
  "dependencies": {
    "openai": "6.49.0",
    "three": "^0.170.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/node": "^24.0.0",
    "@types/three": "^0.170.0",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
